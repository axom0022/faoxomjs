# ==========================================
# FaoxomJS Production .gitignore
# ==========================================

# Dependencies & Package Managers
node_modules/
.npm/
.yarn/
package-lock.json.log

# Sandbox & Runtime Environment Packages
runtime-libs/
.sudo_as_admin_successful

# Cache, Config & System Dirs
.cache/
.config/
.local/
.tmp/
tmp/
temp/

# Build & Test Execution Artifacts (Generated at runtime)
tests/*-report.json
tests/doodleshooter-faoxom.png
tests/faoxom-reference-runtime.png
tests/game-validation-report.json
tests/lifecycle-report.json
tests/performance-report.json

# Local / Scratch Files
Unselected files/
*.log
*.tmp
*.bak

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
