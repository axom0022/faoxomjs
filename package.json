{
  "name": "faoxomjs",
  "version": "8.0.0",
  "description": "Zero-dependency, high-performance, single-file and modular 3D engine for WebGL2 and WebGPU",
  "type": "module",
  "main": "./FaoxomJs.js",
  "module": "./esm/index.js",
  "types": "./FaoxomJs.d.ts",
  "unpkg": "./dist/faoxom.min.js",
  "jsdelivr": "./dist/faoxom.min.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./FaoxomJs.d.ts",
      "import": "./esm/index.js",
      "default": "./FaoxomJs.js"
    },
    "./math": {
      "types": "./esm/math.d.ts",
      "default": "./esm/math.js"
    },
    "./core": {
      "types": "./esm/core.d.ts",
      "default": "./esm/core.js"
    },
    "./performance": {
      "types": "./esm/performance.d.ts",
      "default": "./esm/performance.js"
    },
    "./runtime": {
      "types": "./esm/runtime.d.ts",
      "default": "./esm/runtime.js"
    },
    "./world": {
      "types": "./esm/world.d.ts",
      "default": "./esm/world.js"
    },
    "./geometry": {
      "types": "./esm/geometry.d.ts",
      "default": "./esm/geometry.js"
    },
    "./materials": {
      "types": "./esm/materials.d.ts",
      "default": "./esm/materials.js"
    },
    "./lighting": {
      "types": "./esm/lighting.d.ts",
      "default": "./esm/lighting.js"
    },
    "./postprocessing": {
      "types": "./esm/postprocessing.d.ts",
      "default": "./esm/postprocessing.js"
    },
    "./physics": {
      "types": "./esm/physics.d.ts",
      "default": "./esm/physics.js"
    },
    "./compute": {
      "types": "./esm/compute.d.ts",
      "default": "./esm/compute.js"
    },
    "./loaders": {
      "types": "./esm/loaders.d.ts",
      "default": "./esm/loaders.js"
    },
    "./audio": {
      "types": "./esm/audio.d.ts",
      "default": "./esm/audio.js"
    },
    "./xr": {
      "types": "./esm/xr.d.ts",
      "default": "./esm/xr.js"
    },
    "./react": {
      "types": "./esm/react.d.ts",
      "default": "./esm/react.js"
    },
    "./controls": {
      "types": "./esm/controls.d.ts",
      "default": "./esm/controls.js"
    },
    "./bindings/react": {
      "default": "./bindings/react/index.js"
    },
    "./bindings/vue": {
      "default": "./bindings/vue/index.js"
    },
    "./bindings/svelte": {
      "default": "./bindings/svelte/index.js"
    },
    "./worker": {
      "default": "./src/extras/faoxom-worker.js"
    }
  },
  "files": [
    "FaoxomJs.js",
    "FaoxomJs.d.ts",
    "dist",
    "esm",
    "src",
    "bindings",
    "codemods",
    "bin",
    "tools",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "VERSION"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axom0022/faoxomjs.git"
  },
  "homepage": "https://github.com/axom0022/faoxomjs#readme",
  "bugs": {
    "url": "https://github.com/axom0022/faoxomjs/issues"
  },
  "keywords": [
    "3d",
    "webgl",
    "webgl2",
    "webgpu",
    "renderer",
    "engine",
    "shading",
    "physics",
    "wgsl"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bench": "node tools/faoxombench.mjs",
    "bench:lighting": "node tests/run_advanced_lighting_benchmark.mjs",
    "bench:compare": "node benchmarks/cross-engine/run.mjs",
    "build": "node tools/build_from_src.mjs",
    "test": "npm run typecheck && npm run bench"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babylonjs/core": "9.26.1",
    "playwright": "^1.65.0",
    "terser": "^5.51.2",
    "three": "0.186.1",
    "typescript": "^5.9.3"
  },
  "bin": {
    "faoxom": "./bin/faoxom.mjs"
  }
}
